Output src/generated/align_assignments.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/align_assignments.text"
Enter
Show

Type "w"
Type "5"
Type "i"
Type " "
Escape
Type "j"
Type "j"
Type "^"
Type "w"
Type "3"
Type "i"
Type " "
Escape

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s