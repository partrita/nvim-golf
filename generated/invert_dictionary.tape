Output src/generated/invert_dictionary.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/invert_dictionary.gdscript"
Enter
Show

Type ":"
Type "1"
Type "s"
Type "/"
Type "c"
Type "o"
Type "l"
Type "o"
Type "r"
Type "_"
Type "t"
Type "o"
Type "_"
Type "p"
Type "o"
Type "i"
Type "n"
Type "t"
Type "s"
Type "/"
Type "p"
Type "o"
Type "i"
Type "n"
Type "t"
Type "s"
Type "_"
Type "t"
Type "o"
Type "_"
Type "c"
Type "o"
Type "l"
Type "o"
Type "r"
Type "/"
Enter
Type ":"
Type "%"
Type "s"
Type "/"
Type "\"
Type "("
Type `"`
Type "["
Type "^"
Type `"`
Type "]"
Type "*"
Type `"`
Type "\"
Type ")"
Type " "
Type "="
Type " "
Type "\"
Type "("
Type "["
Type "0"
Type "-"
Type "9"
Type "]"
Type "*"
Type "\"
Type ")"
Type "/"
Type "\"
Type "2"
Type " "
Type "="
Type " "
Type "\"
Type "1"
Type "/"
Type "g"
Enter

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s