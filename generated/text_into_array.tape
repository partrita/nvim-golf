Output src/generated/text_into_array.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/text_into_array.js"
Enter
Show

Type ":"
Type "%"
Type "s"
Type "/"
Type "."
Type "*"
Type "/"
Type `"`
Type "&"
Type `"`
Type "/"
Enter
Type ":"
Type "%"
Type "s"
Type "/"
Type "\"
Type "n"
Type "\"
Type "z"
Type "e"
Type "."
Type "/"
Type ","
Type " "
Type "/"
Type "g"
Enter
Type "I"
Type "["
Escape
Type "A"
Type "]"
Escape

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s