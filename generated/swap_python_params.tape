Output src/generated/swap_python_params.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/swap_python_params.py"
Enter
Show

Type "d"
Type "d"
Type ":"
Type "%"
Type "s"
Type "/"
Type " "
Type "*"
Type "#"
Type "."
Type "*"
Type "/"
Type "/"
Enter
Type ":"
Type "1"
Type "s"
Type "/"
Type "w"
Type "i"
Type "d"
Type "t"
Type "h"
Type ","
Type " "
Type "h"
Type "e"
Type "i"
Type "g"
Type "h"
Type "t"
Type "/"
Type "h"
Type "e"
Type "i"
Type "g"
Type "h"
Type "t"
Type ","
Type " "
Type "w"
Type "i"
Type "d"
Type "t"
Type "h"
Type "/"
Enter

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s