Output src/generated/json_from_env.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/json_from_env.json"
Enter
Show

Type ":"
Type "v"
Type "/"
Type "="
Type "/"
Type "d"
Enter
Type "g"
Type "g"
Type "O"
Type "{"
Escape
Type "G"
Type "o"
Type "}"
Escape
Type ":"
Type "2"
Type ","
Type "$"
Type "-"
Type "1"
Type "s"
Type "/"
Type "^"
Type "\"
Type "("
Type "["
Type "^"
Type "="
Type "]"
Type "*"
Type "\"
Type ")"
Type "="
Type "\"
Type "("
Type "."
Type "*"
Type "\"
Type ")"
Type "$"
Type "/"
Type " "
Type " "
Type " "
Type " "
Type `"`
Type "\"
Type "1"
Type `"`
Type ":"
Type " "
Type `"`
Type "\"
Type "2"
Type `"`
Type ","
Type "/"
Enter
Type ":"
Type "$"
Type "-"
Type "1"
Type "s"
Type "/"
Type ","
Type "$"
Type "/"
Type "/"
Enter

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s