Output src/generated/export_from_mod.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/export_from_mod.rs"
Enter
Show

Type ":"
Type "%"
Type "t"
Type "$"
Enter
Type ":"
Type "4"
Type "s"
Type "/"
Type "^"
Type "/"
Type "\"
Type "r"
Type "/"
Enter
Type ":"
Type "5"
Type ","
Type "$"
Type "s"
Type "/"
Type "m"
Type "o"
Type "d"
Type " "
Type "\"
Type "("
Type "."
Type "*"
Type "\"
Type ")"
Type ";"
Type "/"
Type "p"
Type "u"
Type "b"
Type " "
Type "u"
Type "s"
Type "e"
Type " "
Type "\"
Type "1"
Type ":"
Type ":"
Type "\"
Type "1"
Type ";"
Type "/"
Type "g"
Enter

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s