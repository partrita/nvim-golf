Output src/generated/filling_braces.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/filling_braces.css"
Enter
Show

Type "c"
Type "i"
Type "}"
Type "b"
Type "l"
Type "u"
Type "e"
Escape
Type "j"
Type "c"
Type "i"
Type "}"
Type "g"
Type "r"
Type "e"
Type "e"
Type "n"
Escape
Type "j"
Type "c"
Type "i"
Type "}"
Type "l"
Type "i"
Type "g"
Type "h"
Type "t"
Type "b"
Type "l"
Type "u"
Type "e"
Escape

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s