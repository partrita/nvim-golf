Output src/generated/snake_case_to_camel_case.mp4
Require nvim

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "nvim --clean src/generated/snake_case_to_camel_case.js"
Enter
Show

Type ":"
Type "%"
Type "s"
Type "/"
Type "_"
Type "\"
Type "("
Type "["
Type "a"
Type "-"
Type "z"
Type "]"
Type "\"
Type ")"
Type "\"
Type "("
Type "["
Type "^"
Type "@"
Type "]"
Type "*"
Type ":"
Type "\"
Type ")"
Type "/"
Type "\"
Type "u"
Type "\"
Type "1"
Type "\"
Type "2"
Type "/"
Type "g"
Enter
Type ":"
Type "%"
Type "s"
Type "/"
Type "u"
Type "s"
Type "e"
Type "r"
Type "_"
Type "p"
Type "r"
Type "o"
Type "f"
Type "i"
Type "l"
Type "e"
Type "/"
Type "u"
Type "s"
Type "e"
Type "r"
Type "P"
Type "r"
Type "o"
Type "f"
Type "i"
Type "l"
Type "e"
Type "/"
Enter

Escape

Hide
Type ":w!"
Enter
Show

Sleep 2s